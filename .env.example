# Copy to .env and adjust. The file is read automatically on startup.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# 1 = debug mode for local development. Leave it at 0 (the default) on a server.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Uncomment to switch from SQLite to PostgreSQL
# DB_NAME=budget
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
