# Copy to .env and adjust. The file is read automatically on startup.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# Debug mode stays off unless you turn it on. For local development only,
# change this to 1 in your own .env - never on a server.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Uncomment to switch from SQLite to PostgreSQL
# DB_NAME=budget
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
